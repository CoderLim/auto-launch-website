# Zone: Zone Edit, DNS Edit, Workers Routes Edit, SSL settings, Email Routing.
# Spaceship registrar (https://www.spaceship.com/application/api-manager/) — scopes: domains:write
SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GA4_PARENT_ACCOUNT=accounts/123456789
# Plausible — self-hosted or cloud. Legacy mode (no Sites API token) writes
# plausible_domain + plausible_src to D1; only data-domain varies per site.
